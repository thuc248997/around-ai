# --- database (used by docker compose) ---
POSTGRES_USER=aroundai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aroundai
# for local `npm run dev` outside docker:
DATABASE_URL=postgresql://aroundai:change-me@localhost:5432/aroundai

# --- admin ---
# password for /admin
ADMIN_PASSWORD=change-me
# random string >= 32 chars, e.g. `openssl rand -hex 32`
SESSION_SECRET=

# --- uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50

# --- cloudflare tunnel token (Zero Trust > Networks > Tunnels) ---
TUNNEL_TOKEN=

# --- optional ---
NEXT_PUBLIC_GOOGLE_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
